FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_SYSTEM_PYTHON=1

# Core CLI & build toolchain for autonomous bash execution
RUN sed -i 's/Components: main/Components: main contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends unrar \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    ripgrep \
    ffmpeg \
    fd-find \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    ffmpeg imagemagick exiftool librsvg2-bin poppler-utils qpdf \
    python3-pil python3-numpy \
    gdb lldb strace ltrace tcpdump socat \
    sqlite3 7zip pandoc \
    libcairo2 libcairo2-dev \
    fonts-dejavu python3-pil imagemagick \
    && rm -rf /var/lib/apt/lists/*

# Install uv and GitHub Spec Kit (specify-cli)
RUN pip3 install --break-system-packages --no-cache-dir uv Pillow numpy cairosvg && \
    uv tool install specify-cli

# Install standalone OMP binary into /usr/local/bin (persists under --read-only)
ENV PI_INSTALL_DIR=/usr/local/bin
RUN curl -fsSL https://omp.sh/install | sh
ENV PI_INSTALL_DIR=   

# Create non-root agent user
RUN useradd -m -u 1000 -s /bin/bash agent || true
ENV PATH="/home/agent/.local/bin:/usr/local/bin:${PATH}"
ENV LLAMA_CPP_BASE_URL=http://10.0.0.3:8082

USER agent
WORKDIR /workspace

ENTRYPOINT ["omp"]
