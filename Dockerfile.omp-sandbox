FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_SYSTEM_PYTHON=1

# Core CLI & build toolchain for autonomous bash execution
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    ripgrep \
    fd-find \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv and GitHub Spec Kit (specify-cli)
RUN pip3 install --break-system-packages --no-cache-dir uv && \
    uv tool install specify-cli --from git+https://github.com

# Install standalone OMP binary into /usr/local/bin (persists under --read-only)
RUN PI_INSTALL_DIR=/usr/local/bin curl -fsSL https://omp.sh/install | sh

# Create non-root agent user
RUN useradd -m -u 1000 -s /bin/bash agent || true
ENV PATH="/home/agent/.local/bin:/usr/local/bin:${PATH}"

USER agent
WORKDIR /workspace

ENTRYPOINT ["omp"]
